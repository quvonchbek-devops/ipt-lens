[Unit]
Description=IPT-Lens iptables web panel
Documentation=https://github.com/quvonchbek-devops/ipt-lens
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/ipt-lens/env
ExecStart=/usr/local/bin/ipt-lens $IPTLENS_ARGS
# iptables opens /run/xtables.lock; create it so it can be the only writable path in /run.
ExecStartPre=+/usr/bin/touch /run/xtables.lock
Restart=on-failure
RestartSec=2

# iptables needs CAP_NET_ADMIN (and CAP_NET_RAW for some modules); nothing else.
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes

StateDirectory=ipt-lens
StateDirectoryMode=0700
ProtectSystem=strict
# --persist-file usually points into /etc/iptables.
ReadWritePaths=/run/xtables.lock -/etc/iptables
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
