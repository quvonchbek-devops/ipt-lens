# Copy to /etc/ipt-lens/env and chmod 600.

# API token, at least 16 characters (openssl rand -hex 24). Required when
# --listen is not a loopback address; on loopback, leave it empty and one is
# generated in /var/lib/ipt-lens/token on first start.
IPTLENS_TOKEN=

# Flags passed to ipt-lens. Bind to a VPN address, never to a public one.
IPTLENS_ARGS=--listen 10.8.0.1:8090 --state-dir /var/lib/ipt-lens --persist-file /etc/iptables/rules.v4
